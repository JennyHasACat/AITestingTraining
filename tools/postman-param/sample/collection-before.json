	"item": [
		{
			"name": "Add Lead V2",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.sendRequest(\"https://postman-echo.com/get\", function (err, response) {",
							"    console.log(response.json());",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-odin-appid",
						"value": "salesforce"
					},
					{
						"key": "x-odin-appsecret",
						"value": "{{app_secret}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"url\": \"/services/apexrest/demo/v2/lead\",\n    \"body\": {\n        \"is_lead\": true,\n        \"child\": {\n            \"member_id\": \"demo_member_00001\",\n            \"name\": \"AutoTest-00000\",\n            \"mobile\": \"13800000000\",\n            \"city\": \"Shanghai\",\n            \"scene\": \"Demo Channel_Demo Campaign\",\n            \"union_id\": \"demo_union_id_001\",\n            \"source\": \"mini program\",\n            \"comment\": \"batch test\",\n            \"gender\": \"Female\"\n        },\n        \"action\": \"Offline\",\n        \"request_id\": \"11111111-1111-1111-1111-111111111111\",\n        \"click_id\": \"22222222-2222-2222-2222-222222222222\"\n    },\n    \"http_method\": \"POST\"\n}"
				},
				"url": {
					"raw": "{{apigateway_url}}/api/v1/sf/restapi",
					"host": [
						"{{apigateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"sf",
						"restapi"
					]
				},
				"description": "创建 Lead（网关包装模式：真实 endpoint 与 method 在 body 的 url / http_method 字段里）。改造前问题：name / mobile / request_id 全部硬编码，Runner 迭代会产生重复数据。"
			},
			"response": []
		},
